/* ---- Glossary --------------------------------------------------------------- */
const GLOSSARY = [
  { term:"Tau", def:"A protein that normally stabilizes the tracks (microtubules) inside neurons. In Alzheimer's it becomes altered and clumps together." },
  { term:"Phosphorylated tau (p-tau)", def:"Tau with extra phosphate groups attached. Versions like p-tau217 rise early in Alzheimer's and make strong biomarkers." },
  { term:"Neurofibrillary tangle (NFT)", def:"A tangle of misfolded tau inside a neuron. One of the two classic Alzheimer's lesions." },
  { term:"Amyloid-beta", def:"A peptide that builds into plaques outside neurons. The other classic Alzheimer's lesion." },
  { term:"Amyloid cascade hypothesis", def:"The long dominant idea that amyloid-beta buildup is the first domino that sets the rest of Alzheimer's in motion." },
  { term:"Protofibril / oligomer", def:"Small, soluble clumps of amyloid-beta, thought to be especially toxic. The drug lecanemab targets these." },
  { term:"Biomarker", def:"Something measurable (in blood, spinal fluid, or on a scan) that reflects what is happening in the body." },
  { term:"Phage display", def:"A method that puts proteins on the surface of viruses (phage) so you can fish out the ones that bind your target." },
  { term:"Biopanning", def:"The rounds of binding, washing, and eluting that enrich a phage library for the best binders." },
  { term:"Epitope", def:"The exact small region of a target that an antibody or peptide grabs onto." },
  { term:"ELISA", def:"A plate based assay that uses a color change to measure how much something binds. Your main readout this summer." },
  { term:"Specificity", def:"Whether your binder grabs only the thing you want (modified tau) and not the look-alikes (unmodified tau)." },
  { term:"Monoclonal antibody", def:"A single, uniform antibody that recognizes one epitope. Many drugs and tests are built from these." },
  { term:"Antibody validation", def:"The evidence that an antibody truly binds its intended target and nothing else. The five pillars are a common standard." },
  { term:"Microglia", def:"The brain's resident immune cells. They clean up debris and, when overactive, drive neuroinflammation." },
  { term:"TREM2", def:"A receptor on microglia. Certain rare variants raise Alzheimer's risk, linking the immune system to the disease." },
  { term:"Braak staging", def:"A scale describing how far tau tangles have spread through the brain, stage I through VI." },
  { term:"ABC score", def:"The standard neuropathology scoring of Alzheimer's: Amyloid, Braak tangle stage, and CERAD plaque score." },
  { term:"ATN framework", def:"Classifying Alzheimer's by Amyloid, Tau, and Neurodegeneration biomarkers rather than by symptoms alone." },
  { term:"Calpain", def:"A calcium-activated protease (protein cutter) that can clip tau and other proteins. A long running theme in this lab." },
  { term:"Cryo-EM", def:"Cryo-electron microscopy. Flash freezing molecules to image them at near-atomic detail, used to solve tangle structure." },
  { term:"Reproducibility", def:"Whether an experiment gives the same answer when repeated. The reason for replicates, controls, and clean records." }
];

/* ---- app ---- */
/* ============================================================================
   NeuroNauts Reading Room  ::  APP LOGIC  (vanilla JS, no build step)
============================================================================ */
(function () {
  "use strict";

  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
  const KEY = "neuronauts:v2";

  // order categories appear in the library
  const ORDER = [
    "Our Project", "Phage Display", "Tau Biology", "Amyloid Biology",
    "Neuroimmunology and Microglia", "AD Biomarkers", "Neuropathology and Criteria",
    "Treatments and Translation", "Lab Methods and Rigor"
  ];

  let scholar = null;
  let selectedName = null;
  let libFilter = "all";
  let libQuery = "";

  /* ---------- storage (per scholar, this browser) ---------- */
  function store() { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { return {}; } }
  function save(d) { try { localStorage.setItem(KEY, JSON.stringify(d)); } catch (e) {} }
  function userData() { const d = store(); d[scholar] = d[scholar] || { read: {} }; return d; }

  /* ---------- LOGIN ---------- */
  function buildLogin() {
    const who = $("#who");
    who.innerHTML = "";
    CONFIG.scholars.forEach(name => {
      const b = document.createElement("button");
      b.textContent = name;
      b.onclick = () => {
        selectedName = name;
        $$("#who button").forEach(x => x.classList.remove("sel"));
        b.classList.add("sel");
        $("#err").textContent = "";
      };
      who.appendChild(b);
    });
    $("#brand-cohort").textContent = CONFIG.cohort;
    $("#pass").addEventListener("keydown", e => { if (e.key === "Enter") attempt(); });
    $("#launch").onclick = attempt;
    const last = store()._session;
    if (last && CONFIG.scholars.includes(last)) { scholar = last; enterApp(); }
  }

  function attempt() {
    if (!selectedName) { $("#err").textContent = "Pick your name first, explorer."; return; }
    if ($("#pass").value.trim() !== CONFIG.passcode) {
      $("#err").textContent = "That passcode does not match. Ask " + CONFIG.mentor + ".";
      return;
    }
    scholar = selectedName;
    const d = store(); d._session = scholar; save(d);
    enterApp();
  }

  function enterApp() {
    $("#login").style.display = "none";
    $("#app").style.display = "block";
    $("#greet-name").textContent = scholar;
    buildLibrary();
    buildGlossary();
    showView("library");
  }

  function logout() { const d = store(); delete d._session; save(d); location.reload(); }

  /* ---------- TABS ---------- */
  function showView(id) {
    $$(".view").forEach(v => v.classList.toggle("show", v.id === "view-" + id));
    $$("nav.tabs button").forEach(b => b.classList.toggle("active", b.dataset.view === id));
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  /* ---------- LIBRARY ---------- */
  function buildLibrary() {
    const fwrap = $("#filters");
    const present = Array.from(new Set(PAPERS.map(p => p.cat)));
    const cats = ["all", ...ORDER.filter(c => present.includes(c)), ...present.filter(c => !ORDER.includes(c))];
    fwrap.innerHTML = "";
    cats.forEach(cat => {
      const b = document.createElement("button");
      b.textContent = cat === "all" ? "All topics" : cat;
      b.className = cat === libFilter ? "on" : "";
      b.onclick = () => { libFilter = cat; $$("#filters button").forEach(x => x.classList.remove("on")); b.classList.add("on"); renderLibrary(); };
      fwrap.appendChild(b);
    });
    $("#lib-search").addEventListener("input", e => { libQuery = e.target.value.toLowerCase(); renderLibrary(); });
    renderLibrary();
  }

  function renderLibrary() {
    const wrap = $("#library");
    const ud = userData();
    let list = PAPERS.slice();
    if (libFilter !== "all") list = list.filter(p => p.cat === libFilter);
    if (libQuery) list = list.filter(p =>
      (p.title + " " + p.source + " " + p.why + " " + p.cat).toLowerCase().includes(libQuery));

    // running count of read papers (whole library)
    const totalRead = PAPERS.filter(p => ud[scholar].read[p.id]).length;
    $("#read-count").textContent = totalRead + " of " + PAPERS.length + " read";

    if (!list.length) { wrap.innerHTML = '<p class="sub">No papers match that search.</p>'; return; }

    const groups = {};
    list.forEach(p => { (groups[p.cat] = groups[p.cat] || []).push(p); });
    const orderedCats = Object.keys(groups).sort((a, b) => {
      const ia = ORDER.indexOf(a), ib = ORDER.indexOf(b);
      return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
    });

    let html = "";
    orderedCats.forEach(cat => {
      html += '<div class="cat-group"><div class="cat-title">' + cat + ' <span class="n">' + groups[cat].length + ' papers</span></div>';
      groups[cat].forEach(p => {
        const read = !!ud[scholar].read[p.id];
        const lvl = { start: "Start here", core: "Core read", deep: "Deep dive" }[p.level];
        html += '<div class="paper ' + (read ? "read" : "") + '" data-id="' + p.id + '">' +
          '<label class="check read-toggle" title="Mark as read">' +
            '<input type="checkbox" data-read="' + p.id + '" ' + (read ? "checked" : "") + '>' +
            '<span class="box">&#10003;</span>' +
          '</label>' +
          '<div class="info">' +
            '<div class="ptitle"><a href="' + p.url + '" target="_blank" rel="noopener">' + p.title + '</a></div>' +
            '<div class="psrc">' + p.source + '</div>' +
            '<div class="pwhy">' + p.why + '</div>' +
            '<div class="ptags">' +
              '<span class="lvl ' + p.level + '">' + lvl + '</span>' +
              '<a class="open-link" href="' + p.url + '" target="_blank" rel="noopener">open paper &rarr;</a>' +
            '</div>' +
          '</div></div>';
      });
      html += "</div>";
    });
    wrap.innerHTML = html;

    $$("[data-read]").forEach(cb => cb.addEventListener("change", e => {
      const id = e.target.dataset.read;
      const d = userData();
      if (e.target.checked) d[scholar].read[id] = true; else delete d[scholar].read[id];
      save(d);
      e.target.closest(".paper").classList.toggle("read", e.target.checked);
      const tot = PAPERS.filter(p => d[scholar].read[p.id]).length;
      $("#read-count").textContent = tot + " of " + PAPERS.length + " read";
    }));
  }

  /* ---------- GLOSSARY ---------- */
  function buildGlossary() {
    $("#glossary").innerHTML = GLOSSARY.map(g =>
      '<div class="gloss"><dt>' + g.term + '</dt><dd>' + g.def + '</dd></div>').join("");
  }

  /* ---------- boot ---------- */
  document.addEventListener("DOMContentLoaded", () => {
    $("#brand-mentor").textContent = CONFIG.mentor + "'s lab";
    buildLogin();
    $("#logout").onclick = logout;
    $$("nav.tabs button").forEach(b => b.onclick = () => showView(b.dataset.view));
  });
})();

</script>
</body>
</html>
